# Toutes les variables sont optionnelles : les valeurs ci-dessous sont les valeurs par défaut.

# Données brutes et artefacts du modèle (chemins relatifs à backend/ ou absolus)
# DATA_DIR=../preprocessing/data/raw
# ARTIFACTS_DIR=artifacts
# DB_PATH=var/app.db

# Date « aujourd'hui » de la démo (défaut : 14 jours avant la fin des données)
# REFERENCE_DATE=2023-12-17

# Origines autorisées (frontend)
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# Marges de sécurité des règles de commande
# SEAT_SAFETY_MARGIN=0.15
# AI_SAFETY_MARGIN=0.05
